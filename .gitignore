node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database backups
*.dump
*.backup

# Logs
*.log
logs/

# IDE and editor configuration
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
